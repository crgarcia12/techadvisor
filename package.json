{
  "name": "techadvisor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:server": "npm run dev --workspace=packages/server",
    "dev:web": "npm run dev --workspace=packages/web",
    "dev": "npm-run-all --parallel dev:server dev:web",
    "build:web": "npm run build --workspace=packages/web",
    "start": "npm run start --workspace=packages/server",
    "test": "node tests/socket-test.js"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
