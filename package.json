{
  "name": "techadvisor",
  "version": "1.0.0",
  "private": true,
  "description": "Chat-driven, web-crawled product comparison (TVs and more).",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build && npm --workspace server run build",
    "start": "npm --workspace server run start",
    "lint": "npm --workspace server run lint && npm --workspace web run lint",
    "test": "npm --workspace server run test",
    "test:e2e": "cucumber-js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "concurrently": "^9.1.0",
    "playwright": "^1.48.2",
    "typescript": "^5.6.3"
  }
}
