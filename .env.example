# Azure Foundry TechAdvisor - Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================================================
# Azure Authentication & Identity
# ============================================================================

# Azure Subscription ID - find this in Azure Portal under Subscriptions
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Azure AD Tenant ID - your organization's Azure AD tenant identifier
AZURE_TENANT_ID=your-tenant-id-here

# Service Principal Client ID - create via: az ad sp create-for-rbac
AZURE_CLIENT_ID=your-client-id-here

# Service Principal Client Secret - generated with the service principal
AZURE_CLIENT_SECRET=your-client-secret-here

# ============================================================================
# Azure Resource Configuration
# ============================================================================

# Resource Group - where your Azure resources will be deployed
AZURE_RESOURCE_GROUP=rg-techadvisor-dev

# Azure Region - location for resource deployment
# Examples: eastus, westus2, westeurope, southeastasia
AZURE_LOCATION=eastus

# Azure OpenAI or AI Services endpoint (if using AI features)
# AZURE_OPENAI_ENDPOINT=https://your-openai-instance.openai.azure.com/

# Azure OpenAI API Key (if using AI features)
# AZURE_OPENAI_API_KEY=your-api-key-here

# Azure OpenAI Deployment Name (if using AI features)
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# ============================================================================
# Application Configuration
# ============================================================================

# Application Port - port the application listens on
# Liliput sets this automatically in deployment
PORT=3000

# Node Environment - development, staging, or production
NODE_ENV=development

# Application Base Path - for reverse proxy deployments
# Leave empty for Liliput (proxy handles path stripping)
BASE_PATH=

# ============================================================================
# Logging & Monitoring
# ============================================================================

# Log Level - error, warn, info, debug, trace
LOG_LEVEL=info

# Application Insights Connection String (optional)
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key-here

# ============================================================================
# Feature Flags (Optional)
# ============================================================================

# Enable advanced code analysis features
# ENABLE_ADVANCED_ANALYSIS=false

# Enable multi-language support
# ENABLE_MULTILANG=true

# ============================================================================
# Security Configuration
# ============================================================================

# API Key for authenticated endpoints (if required)
# API_KEY=your-secure-api-key-here

# CORS Allowed Origins (comma-separated)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ============================================================================
# Development & Testing
# ============================================================================

# Disable authentication for local development (NEVER in production)
# DEV_DISABLE_AUTH=false

# Mock external services for testing
# MOCK_EXTERNAL_SERVICES=false
