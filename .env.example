# Environment variables for Azure AI Foundry LLM Provider
# Copy this file to .env and fill in your values

# Azure AI Foundry endpoint (required)
AZURE_FOUNDRY_ENDPOINT=https://your-endpoint.openai.azure.com

# Azure AI Foundry API key (required)
AZURE_FOUNDRY_API_KEY=your-api-key-here

# Azure AI Foundry deployment ID (optional, defaults to gpt-4)
AZURE_FOUNDRY_DEPLOYMENT_ID=gpt-4

# Server port (optional, defaults to 3000)
PORT=3000
