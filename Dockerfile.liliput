# Auto-generated by Liliput — replace with your own Dockerfile when ready.
# Use Microsoft's MCR mirror instead of Docker Hub to avoid anonymous-pull
# rate limits on the shared ACR Build agent IP pool.
FROM mcr.microsoft.com/azurelinux/base/nodejs:20
WORKDIR /app
COPY package*.json ./
RUN npm install --no-audit --no-fund
COPY . .
# Bake the Liliput proxy prefix into the Vite build so browser-side asset, API
# and Socket.IO URLs are prefixed (deploy contract rule #4/#5). nginx strips the
# prefix before requests reach this container, so server routes stay at "/".
ENV PUBLIC_BASE_PATH=/dev/crgarcia12/techadvisor/liliput-task-8a533163/
# The Liliput platform injects Azure AI Foundry credentials via the
# `liliput-azure-sp` secret (envFrom). This preview is meant to demonstrate the
# deterministic, offline-friendly guided flow (see the "graceful handling when
# Azure AI Foundry is not configured" acceptance scenario), so force the
# rule-based responder here rather than making live LLM calls.
ENV TECHADVISOR_DISABLE_AI=true
RUN npm run build
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "npm start"]
